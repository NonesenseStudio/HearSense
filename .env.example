# Nuxt local development. Never commit secrets in this file.
# Personal access gate: store only the MD5 hash in D1 with the setup command.
# ACCESS_PASSWORD is a temporary shell variable for pnpm access:password:set; do not put it in .env.
# Optional: use a separate random value (32+ characters) to sign sessions.
# NUXT_ACCESS_COOKIE_SECRET=
# Session lifetime in seconds; defaults to 7 days and is clamped to 1 hour–90 days.
NUXT_ACCESS_SESSION_TTL_SECONDS=604800
# D1 database_id 已直接写在 wrangler.jsonc 中（D1 ID 非机密，可提交仓库）。
# - pnpm db:migrate:local  使用本地数据库副本，无需配置
# - pnpm db:migrate:remote / pnpm run deploy  需要先 wrangler login
NUXT_UAPIS_BASE_URL=https://uapis.cn
NUXT_YOUDAO_BASE_URL=https://dict.youdao.com
NUXT_DICTIONARY_TIMEOUT_MS=6000
# Optional: configure a server-only uapis API key. In production prefer:
# wrangler secret put NUXT_UAPIS_API_KEY
# NUXT_UAPIS_API_KEY=
