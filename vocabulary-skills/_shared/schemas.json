{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/words-app-pre/vocabulary-skills/schemas.json",
  "title": "Ear-to-Meaning Vocabulary Contracts",
  "$defs": {
    "state": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4"]
    },
    "container": {
      "type": "string",
      "enum": ["candidate_inbox", "active_review", "graduated"]
    },
    "result": {
      "type": "string",
      "enum": ["INSTANT", "SLOW", "VAGUE", "FAIL"]
    },
    "testMode": {
      "type": "string",
      "enum": ["audio", "written", "contextual", "production"]
    },
    "source": {
      "type": "string",
      "enum": [
        "movie",
        "tv",
        "song",
        "youtube",
        "podcast",
        "game",
        "conversation",
        "book",
        "article",
        "school",
        "work",
        "other"
      ]
    },
    "wordRecord": {
      "type": "object",
      "required": ["word", "state", "container", "active"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "word": { "type": "string", "minLength": 1 },
        "pronunciation": { "type": ["string", "null"] },
        "state": { "$ref": "#/$defs/state" },
        "container": { "$ref": "#/$defs/container" },
        "core_meaning_en": { "type": ["string", "null"] },
        "core_meaning_zh": { "type": ["string", "null"] },
        "anchor_sentence": { "type": ["string", "null"] },
        "semantic_scene": { "type": ["string", "null"] },
        "source": {
          "anyOf": [{ "$ref": "#/$defs/source" }, { "type": "null" }]
        },
        "source_context": { "type": ["string", "null"] },
        "encounter_count": { "type": ["integer", "null"], "minimum": 0 },
        "retrieval_latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "audio_success": { "type": ["boolean", "null"] },
        "active_usage_verified": { "type": "boolean" },
        "recent_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/result" }
        },
        "last_result": {
          "anyOf": [{ "$ref": "#/$defs/result" }, { "type": "null" }]
        },
        "mastery_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 3
        },
        "active": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "intakeInput": {
      "type": "object",
      "required": ["word"],
      "properties": {
        "word": { "type": "string", "minLength": 1 },
        "learner_report": { "type": ["string", "null"] },
        "source": {
          "anyOf": [{ "$ref": "#/$defs/source" }, { "type": "null" }]
        },
        "source_context": { "type": ["string", "null"] },
        "encounter_count": { "type": ["integer", "null"], "minimum": 0 },
        "heard_before": { "type": ["boolean", "null"] },
        "seen_before": { "type": ["boolean", "null"] },
        "audio_familiarity": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        },
        "current_state": {
          "anyOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }]
        },
        "active_review_count": { "type": ["integer", "null"], "minimum": 0 },
        "candidate_count": { "type": ["integer", "null"], "minimum": 0 },
        "personal_relevance": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        }
      },
      "additionalProperties": true
    },
    "intakeOutput": {
      "type": "object",
      "required": [
        "word",
        "classification",
        "container",
        "admit",
        "needs_clarification"
      ],
      "properties": {
        "word": { "type": "string" },
        "classification": { "$ref": "#/$defs/state" },
        "container": { "$ref": "#/$defs/container" },
        "admit": { "type": "boolean" },
        "priority": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "admission_reasons": { "type": "array", "items": { "type": "string" } },
        "activation_blocked_by_debt": { "type": "boolean" },
        "needs_clarification": { "type": "boolean" },
        "clarifying_question": { "type": ["string", "null"] },
        "next_skill": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "reviewEvent": {
      "type": "object",
      "required": ["word", "test_mode", "learner_response"],
      "properties": {
        "word_id": { "type": ["string", "null"] },
        "word": { "type": "string" },
        "test_mode": { "$ref": "#/$defs/testMode" },
        "learner_response": { "type": "string" },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "answer_revealed": { "type": "boolean" },
        "context_used": { "type": ["string", "null"] },
        "is_natural_reencounter": { "type": "boolean" },
        "timestamp": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": true
    },
    "reviewOutput": {
      "type": "object",
      "required": [
        "word",
        "result",
        "test_mode",
        "contaminated",
        "state_before",
        "state_after",
        "graduated",
        "reentered"
      ],
      "properties": {
        "word": { "type": "string" },
        "result": { "$ref": "#/$defs/result" },
        "test_mode": { "$ref": "#/$defs/testMode" },
        "contaminated": { "type": "boolean" },
        "state_before": { "$ref": "#/$defs/state" },
        "state_after": { "$ref": "#/$defs/state" },
        "container_after": { "$ref": "#/$defs/container" },
        "graduated": { "type": "boolean" },
        "reentered": { "type": "boolean" },
        "mastery_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 3
        },
        "recent_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/result" }
        },
        "feedback": { "type": "string" },
        "next_action": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sessionPlan": {
      "type": "object",
      "required": [
        "duration_minutes",
        "active_review_count_before",
        "new_word_limit",
        "debt_status",
        "session"
      ],
      "properties": {
        "date": { "type": ["string", "null"] },
        "duration_minutes": { "type": "number", "minimum": 0, "maximum": 20 },
        "active_review_count_before": { "type": "integer", "minimum": 0 },
        "new_word_limit": { "type": "integer", "minimum": 0, "maximum": 5 },
        "debt_status": {
          "type": "string",
          "enum": ["controlled", "watch", "blocked"]
        },
        "active_word_ids": { "type": "array", "items": { "type": "string" } },
        "new_word_ids": { "type": "array", "items": { "type": "string" } },
        "session": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["phase", "minutes", "word_ids"],
            "properties": {
              "phase": { "type": "string" },
              "minutes": { "type": "number", "minimum": 0 },
              "word_ids": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "reason": { "type": "string" },
        "next_skill": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}
