{
  "name": "HearSense",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:worker": "pnpm build && wrangler dev",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dictionary:build": "node scripts/dictionary/build-ecdict.mjs --profile=core",
    "dictionary:build:full": "node scripts/dictionary/build-ecdict.mjs --profile=full",
    "dictionary:config:check": "node scripts/dictionary/check-config.mjs",
    "dictionary:verify": "node scripts/dictionary/verify-ecdict.mjs --profile=core",
    "generate": "nuxt generate",
    "preview": "wrangler dev",
    "deploy": "pnpm dictionary:config:check && pnpm build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "h3": "^1.15.11",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.128.0"
  }
}
